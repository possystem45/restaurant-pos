# API Base URL for development
VITE_API_URL=http://localhost/api

# AWS Server Configuration (for deployment reference)
# Note: Replace with your actual AWS server IP
AWS_SERVER_IP=your_aws_server_ip

# Environment
VITE_NODE_ENV=development

# App Configuration
VITE_APP_NAME=Restaurant POS

# Admin/Manager Access Password
# Change this to a secure password for production
VITE_MANAGER_PASSWORD=your_secure_password

VITE_APP_VERSION=1.0.0

# Optional Configuration
# PORT=5000
# FRONTEND_URL=http://localhost:3000